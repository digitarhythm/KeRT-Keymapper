# Build environment for the browser version, the same as the GitHub Actions runner (Ubuntu 22.04).
# Used by web/build-local.sh on macOS, where the Command Line Tools cannot build Qt's host tools.
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git python3 python3-venv python3-pip python-is-python3 perl wget curl ca-certificates \
        xz-utils bzip2 unzip file patch cmake ninja-build pkg-config \
        zlib1g-dev libffi-dev libssl-dev libbz2-dev liblzma-dev libsqlite3-dev libreadline-dev \
    && rm -rf /var/lib/apt/lists/*
